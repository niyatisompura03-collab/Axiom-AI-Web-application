# =========================
# Axiom - Root Git Ignore
# =========================

# -------------------------
# Environment / Secrets
# -------------------------
.env
.env.*
!.env.example

# -------------------------
# Python
# -------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# -------------------------
# Node.js
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------
# Next.js
# -------------------------
.next/
out/
.vercel/

# -------------------------
# Build / generated files
# -------------------------
build/
dist/
*.tsbuildinfo

# -------------------------
# OS
# -------------------------
.DS_Store
Thumbs.db

# -------------------------
# Editors
# -------------------------
.vscode/
.idea/

# -------------------------
# Logs
# -------------------------
*.log